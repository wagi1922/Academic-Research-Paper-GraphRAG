# Academic GraphRAG - Environment Variables
# NEO4J_PASSWORD should be set to a secure value
NEO4J_PASSWORD=graphrag123

# OpenRouter API Key (required for LLM and embeddings)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Neo4j Database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# LLM Models (OpenRouter model IDs)
LLM_MODEL=openrouter/gpt-4o-mini
EMBEDDING_MODEL=openrouter/nomic-embed-text

# Optional: Local Ollama (for local LLM fallback)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# GROBID for PDF parsing (internal docker network)
GROBID_URL=http://grobid:8070

# Experiment Settings
EXPERIMENT_OUTPUT_DIR=experiments/results