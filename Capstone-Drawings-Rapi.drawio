        <mxCell id="s6_label" value="6. GraphWriter.batch_write()\n(Cypher MERGE, APOC)\n→ Nodes + Edges" style="shape=connector;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#37474F;" vertex="1" parent="1">
          <mxGeometry x="550" y="400" width="150" height="40" as="geometry" />
