        <mxCell id="s5_label" value="5. LLM.extract_entities(chunk)\n→ Entities + Relations (JSON)" style="shape=connector;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#C2185B;" vertex="1" parent="1">
          <mxGeometry x="550" y="360" width="150" height="40" as="geometry" />
