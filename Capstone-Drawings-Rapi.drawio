        <mxCell id="s9_label" value="9. Return {job_id, status}\nAsync polling: GET /status/{job_id}" style="shape=connector;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="110" y="520" width="150" height="40" as="geometry" />
