        </mxCell>
        <mxCell id="s8_label" value="8. VectorIndex.upsert(vectors)\n→ Neo4j Vector Index" style="shape=connector;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#37474F;" vertex="1" parent="1">
