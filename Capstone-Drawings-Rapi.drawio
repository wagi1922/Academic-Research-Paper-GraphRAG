        <mxCell id="s3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6A1B9A;strokeWidth=2;endArrow=block;fontSize=10;" edge="1" parent="1" source="ingestion_svc" target="grobid_svc">
