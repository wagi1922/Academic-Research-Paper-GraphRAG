        <mxCell id="s7_label" value="7. EmbeddingModel.embed(chunks)\n→ vectors" style="shape=connector;whiteSpace=wrap;html=1;fontSize=9;strokeColor=#C2185B;" vertex="1" parent="1">
          <mxGeometry x="550" y="440" width="100" height="40" as="geometry" />
        </mxCell>
        <!-- 8. Vector Index Upsert -->
        <mxCell id="s8" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#37474F;strokeWidth=2;endArrow=block;fontSize=10;" edge="1" parent="1" source="ingestion_svc" target="neo4j_svc">
          <mxGeometry relative="1" as="geometry" y="500">
