# Academic GraphRAG - Environment Variables Template
# Copy to .env and fill in your values

# OpenRouter API Key (required for LLM and embeddings)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Neo4j Database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme_secure_password
NEO4J_DATABASE=neo4j

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# LLM Models (OpenRouter FREE model IDs only — NO PAID, NO LOCAL)
LLM_MODEL=inclusionai/ling-3.2-flash:free
EMBEDDING_MODEL=nomic-embed-text-v1.5:free
# Fallback free models (uncomment to swap):
# LLM_MODEL=particle-ai/particle-1:free
# LLM_MODEL=nvidia/nemotron-3.5-lightning:free
# LLM_MODEL=google/gemma-4-31b-it:free
# EMBEDDING_MODEL=inclusionai/ling-3.2-flash:free
# EMBEDDING_MODEL=particle-ai/particle-1:free

# Grobid for PDF parsing
GROBID_URL=http://host.docker.internal:8070

# Experiment Settings
EXPERIMENT_OUTPUT_DIR=experiments/results